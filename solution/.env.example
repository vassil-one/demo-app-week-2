# Copy to .env — Compose reads it automatically and interpolates ${VAR} in compose.yaml.
# Never commit .env (it is in .gitignore); that is where real secrets would go.

# Host port published for the app (container port stays 8000)
APP_PORT=8000

# Where the app finds Redis. In Compose this is the SERVICE NAME, not localhost.
REDIS_HOST=redis
REDIS_PORT=6379
